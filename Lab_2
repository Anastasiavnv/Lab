import decimal
from decimal import Decimal, ROUND_HALF_UP # Подключаем штуку для правильного округления

# Тут меняй имя файла: inmap0.dat, inmap1.dat или inmap2.dat
filename = "inmap1.dat"

try:
    # Открываем файл и читаем все строки
    with open(filename, 'r') as file:
        lines = file.readlines()
        
    # Первая строка — это количество локаций и масштаб
    first_line = lines[0].split()
    num_locations = int(first_line[0]) 
    scale = Decimal(first_line[1]) # Берем масштаб как Decimal для точности
    
    # Собираем все остальные расстояния в список
    map_distances = []
    for line in lines[1:]:
        if line.strip(): # Если строка не пустая
            map_distances.append(Decimal(line.strip())) # Тоже переводим в Decimal
            
    # Выводим шапку (впиши сюда свое имя, если надо)
    print("Dwight Barnette") 
    print("Simple Map Distance Computations")
    print()
    
    # Выводим масштаб (тут 4 пробела перед 0.25)
    print(f"Map Scale Factor:    {scale:.2f} miles per inch")
    print()
    
    # Заголовки таблицы
    print("      Map       Mileage")
    print("      Measure   Distance")
    
    # Линия из 60 знаков равно
    print("=" * 60)
    
    total_distance = Decimal('0.0')
    
    # Идем по списку расстояний
    for i, map_dist in enumerate(map_distances, start=1):
        # Считаем мили: умножаем дюймы на масштаб
        mileage = map_dist * scale
        total_distance += mileage
        
        # Округляем правильно (2.25 станет 2.3, а не 2.2)
        mileage_rounded = mileage.quantize(Decimal('0.1'), rounding=ROUND_HALF_UP)
        
        # Форматируем строку. 
        # {map_dist:<5.1f} — оставляет место под число (9.0 или 10.0) и выравнивает.
        print(f"#  {i}    {map_dist:<5.1f}     {mileage_rounded:.1f}")
        
    # Закрываем таблицу линией
    print("=" * 60)
    
    # Округляем и выводим итог (тут 4 пробела после двоеточия)
    total_rounded = total_distance.quantize(Decimal('0.1'), rounding=ROUND_HALF_UP)
    print(f"Total Distance:    {total_rounded:.1f} miles")

except FileNotFoundError:
    print("Файл не найден, проверь название и папку!")

# B2
# Тут указываем файл, который будем читать (можешь поменять на 2.WCData.txt или 3.WCData.txt)
input_filename = "1.WCData.txt"
output_filename = "1.WindChillReport.txt" # Файл, куда запишем результат

try:
    # Открываем входной файл для чтения (r) и выходной для записи (w)
    with open(input_filename, 'r') as infile, open(output_filename, 'w') as outfile:
        lines = infile.readlines()
        
        # Выводим заголовки в файл (обрати внимание на пробелы, они как в эталоне)
        outfile.write("Time     WC temp     WC Effect\n")
        outfile.write("-" * 30 + "\n")
        
        # Сюда будем складывать все WC температуры, чтобы потом найти среднее
        total_wc_temp = 0.0
        count = 0
        
        # Пропускаем первые две строки (там просто текст заголовков)
        data_lines = lines[2:]
        
        for line in data_lines:
            # Пропускаем пустые строки, если они есть
            if not line.strip():
                continue
                
            # Разбиваем строку на части по пробелам: время, температура, ветер
            parts = line.split()
            time_str = parts[0]
            air_temp = float(parts[1])  # Температура воздуха
            wind_speed = float(parts[2]) # Скорость ветра
            
            # Если ветер больше 3, считаем по сложной формуле из методички
            if wind_speed > 3:
                # Формула Wind Chill (в градусах Фаренгейта)
                wc_temp = 35.74 + 0.6215 * air_temp - 35.75 * (wind_speed ** 0.16) + 0.4275 * air_temp * (wind_speed ** 0.16)
            else:
                # Если ветра почти нет, то воздух не ощущается холоднее
                wc_temp = air_temp
                
            # Считаем эффект (насколько градусов холоднее ощущается)
            wc_effect = wc_temp - air_temp
            
            # Прибавляем к общей сумме (для среднего)
            total_wc_temp += wc_temp
            count += 1
            
            # !!! ВАЖНЫЙ МОМЕНТ: форматирование строки !!!
            # {time_str} - время как есть
            # {wc_temp:^10.1f} - 10 знаков по центру, 1 цифра после точки (для выравнивания)
            # {wc_effect:^10.1f} - то же самое для эффекта
            # Внимание: я использую ^ (по центру), чтобы отрицательные числа вставали ровно
            outfile.write(f"{time_str} {wc_temp:>8.1f} {wc_effect:>12.1f}\n")
            
        # После цикла ставим разделительную линию
        outfile.write("-" * 30 + "\n\n")
        
        # Считаем среднее и округляем до 1 знака
        avg_temp = total_wc_temp / count
        outfile.write(f"The average adjusted temperature, based on {count} observations, was {avg_temp:.1f}\n")

    print(f"Готово! Результат сохранен в {output_filename}")

except FileNotFoundError:
    print("Ошибка: файл с данными не найден. Проверь название!")
